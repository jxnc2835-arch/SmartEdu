# ============================================================
# SmartEdu — 学生管理系统环境配置模板
# 复制本文件为 .env 并填写实际值
# ============================================================

# ----- 必填配置 -----
# JWT 密钥（用于身份认证，建议使用随机生成的强密钥）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here-min-32-chars

# JWT Token 过期时间（默认 2h，可配置为 '1h', '4h', '7d' 等）
JWT_EXPIRY=2h

# 服务端口
PORT=3000

# HTTPS 端口（可选，需要 ssl/ 目录下有 server.key 和 server.crt）
HTTPS_PORT=3443

# 默认管理员密码（首次启动时创建 admin 账号使用）
# 留空则自动生成随机密码并输出到日志
DEFAULT_ADMIN_PASSWORD=

# 日志级别（debug, info, warn, error）
LOG_LEVEL=info

# ----- AI 服务配置 -----
# 智谱 AI GLM-4 API 密钥（用于智能问答和预测）
# 注册地址: https://bigmodel.cn
ZHIPU_AI_API_KEY=your-zhipu-api-key-here
ZHIPU_AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ----- 地图服务配置（可选）-----
# 高德地图 API 密钥（用于位置服务）
AMAP_MAP_KEY=
# 腾讯地图 API 密钥
TENCENT_MAP_KEY=
# 百度地图 API 密钥
BAIDU_MAP_KEY=

# ----- 数据库配置（可选）-----
# SQLite 数据库文件路径
DATABASE_PATH=data.db

# ----- 通知配置（可选）-----
# Webhook 地址（用于接收系统通知）
WEBHOOK_URL=
WEBHOOK_ENABLED=0

# 企业微信 Webhook
WECOM_WEBHOOK_URL=
WECOM_ENABLED=0

# 钉钉 Webhook
DINGTALK_WEBHOOK_URL=
DINGTALK_ENABLED=0

# ----- 安全配置（可选）-----
# 登录失败最大尝试次数
MAX_LOGIN_ATTEMPTS=5
# 登录锁定时间（分钟）
LOGIN_LOCKOUT_MINUTES=15
